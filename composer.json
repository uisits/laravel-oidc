{
    "name": "uisits/laravel-oidc",
    "description": "Shibboleth OIDC driver for Laravel Socialite",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "Laravel", "Socialite", "Shibboleth", "Laravel Socialite Shibboleth Provider"
    ],
    "support": {
        "issues": "https://github.com/uisits/laravel-oidc/issues",
        "source": "https://github.com/uisits/laravel-oidc"
    },
    "authors": [
        {
            "name": "Chinwal, Prasad"
        }
    ],
    "require": {
        "php": "^8.4|^8.5",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.10",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "UisIts\\Oidc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "UisIts\\Oidc\\ShibbolethServiceProvider"
            ]
        },
        "aliases": {
            "Oidc": "UisIts\\Oidc\\Facades\\Oidc"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
